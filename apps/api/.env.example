QWEN_API_KEY=
QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
PLANNER_PROVIDER=auto

# ESP32 reply-audio TTS. Default keeps the local Windows voice that already
# works with the board speaker. Set provider to mimo or dashscope to use a
# cloud voice. MiMo voices observed in the current endpoint include:
# mimo_default, 冰糖, 茉莉, 苏打, 白桦, Mia, Chloe, Milo, Dean.
VOICE_CHAT_TTS_PROVIDER=windows
VOICE_CHAT_TTS_API_KEY=
VOICE_CHAT_TTS_API_BASE=https://dashscope.aliyuncs.com/api/v1
VOICE_CHAT_TTS_MODEL=qwen3-tts-flash
VOICE_CHAT_TTS_VOICE=Cherry
VOICE_CHAT_TTS_LANGUAGE_TYPE=Chinese

# Voice transcription provider for ESP32 WAV/PCM uploads.
# auto uses MiMo ASR when the active provider key is configured, then falls back
# to faster-whisper and Windows Speech Recognition.
VOICE_CHAT_ASR_PROVIDER=auto
VOICE_CHAT_ASR_MODEL=mimo-v2.5-asr
VOICE_CHAT_ASR_LANGUAGE=zh-CN

# Optional SQLite memory store. Leave empty for in-process session memory only.
# Use an absolute path on Ubuntu/LAN deployments, for example:
# VOICE_CHAT_MEMORY_DB=/opt/homecue-edge/data/voice-chat.sqlite
VOICE_CHAT_MEMORY_DB=

# Optional app-layer token for voice, memory/task, and ESP32 diagnostic routes.
# Leave empty for local/LAN development. Set before exposing through Cloudflare.
VOICE_CHAT_ACCESS_TOKEN=
